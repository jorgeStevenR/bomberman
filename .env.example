# Copia este archivo como ".env" y cambia los valores antes de usarlo en serio.
# ".env" está en .gitignore: los secretos nunca se suben a Git.
# (En AWS estos valores estarían en Secrets Manager / Parameter Store.)

POSTGRES_PASSWORD=cambia-esta-contrasena
API_TOKEN=cambia-este-token-interno
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambia-esta-contrasena-de-grafana
