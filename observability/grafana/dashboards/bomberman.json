    {
      "id": 5,
      "type": "row",
      "title": "Balanceo de carga",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Salas creadas por réplica del game-server",
      "description": "Nginx reparte las salas con hash consistente del código de sala: cada sala vive en una sola réplica.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (instance) (count_over_time({service=\"game-server\"} |= \"creada en el servidor\" | json | __error__=\"\" [$__interval]))",
          "legendFormat": "{{instance}}",
          "queryType": "range"
        }
      ],
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "piechart",
      "title": "Peticiones a la API por instancia",
      "description": "Nginx reparte la API con least_conn entre api-1 y api-2.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (upstream_name) (count_over_time({service=\"nginx\"} | json | __error__=\"\" | path=~\"/api/.*\" and upstream_name != \"\" [$__interval]))",
          "legendFormat": "{{upstream_name}}",
          "queryType": "range"
        }
      ],
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Peticiones por instancia (por minuto)",
      "description": "Reparto de peticiones HTTP/WebSocket a lo largo del tiempo.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 5
