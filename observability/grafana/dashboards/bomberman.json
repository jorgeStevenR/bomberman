    {
      "id": 10,
      "type": "timeseries",
      "title": "Respuestas HTTP por código de estado",
      "description": "Muchas 4xx = clientes con peticiones inválidas o bloqueadas; 5xx = fallo en el backend.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 14
