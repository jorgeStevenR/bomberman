    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Latencia de la API (p50 / p95)",
      "description": "Tiempo de respuesta de cada instancia de la API, medido en el propio log.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.50, {service=\"api\"} | json | __error__=\"\" | unwrap duration_ms [1m]) by (container)",
          "legendFormat": "p50 {{container}}",
          "queryType": "range"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.95, {service=\"api\"} | json | __error__=\"\" | unwrap duration_ms [1m]) by (container)",
          "legendFormat": "p95 {{container}}",
          "queryType": "range"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      }
    },
